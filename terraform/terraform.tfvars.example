# Copy to terraform.tfvars, which is ignored by Git. Provide vSphere credentials
# through TF_VAR_vsphere_user / TF_VAR_vsphere_password or Terraform Cloud; never
# save credentials in this file.

# vSphere placement and source image.
vsphere_server               = "vcenter.example.internal"
vsphere_allow_unverified_ssl = false # Set true only for a short-lived lab with a self-signed vCenter certificate.
datacenter_name              = "Example-Datacenter"
compute_cluster_name         = "Example-Cluster"
datastore_name               = "Example-Datastore"
network_name                 = "Example-Port-Group"
vm_folder                    = "Rancher"
content_library_name         = "Example-Content-Library"
content_library_item_name    = "ubuntu-24-04"
content_library_item_type    = "ovf" # Valid values: ovf, vm-template.

# Set this to an existing customization specification, or leave blank to skip
# vSphere guest customization. Confirm that its guest OS settings match the image.
customization_spec_name = ""

# VM sizing and image access. node_count is intentionally fixed at three.
cluster_name = "rancher-prod"
num_cpus     = 4
memory_mb    = 16384
disk_gb      = 100
ssh_username = "ansible"
guest_id     = "ubuntu64Guest"
scsi_type    = "pvscsi"

# Leave enabled when the image supports the VMware guestinfo cloud-init datasource.
cloud_init_enabled = true
# additional_cloud_init = ""
